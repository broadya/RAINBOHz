{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "description": "Pins the compiler to clang, as rendering-engine does: a stale CC/CXX export must not silently change what this project is built with.",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "SP_BUILD_TESTS": "ON"
      }
    },
    { "name": "debug",   "hidden": true, "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "hidden": true, "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } },

    {
      "name": "macos-debug",
      "displayName": "macOS arm64 - Debug",
      "inherits": "debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-release",
      "displayName": "macOS arm64 - RelWithDebInfo",
      "inherits": "release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux (host arch) - Debug",
      "inherits": "debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux (host arch) - RelWithDebInfo",
      "inherits": "release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],

  "buildPresets": [
    { "name": "macos-debug",   "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "linux-debug",   "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ],

  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "macos-debug",   "inherits": "base", "configurePreset": "macos-debug" },
    { "name": "macos-release", "inherits": "base", "configurePreset": "macos-release" },
    { "name": "linux-debug",   "inherits": "base", "configurePreset": "linux-debug" },
    { "name": "linux-release", "inherits": "base", "configurePreset": "linux-release" }
  ],

  "workflowPresets": [
    {
      "name": "macos-debug",
      "steps": [
        { "type": "configure", "name": "macos-debug" },
        { "type": "build",     "name": "macos-debug" },
        { "type": "test",      "name": "macos-debug" }
      ]
    },
    {
      "name": "linux-debug",
      "steps": [
        { "type": "configure", "name": "linux-debug" },
        { "type": "build",     "name": "linux-debug" },
        { "type": "test",      "name": "linux-debug" }
      ]
    }
  ]
}
